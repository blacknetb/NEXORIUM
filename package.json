{
  "name": "enterprise-service-management",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Service Management — Monorepo con backend, frontend web y app Android.",
  "license": "MIT",
  "author": "Enterprise Service Management Team",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.16.0",
    "npm": ">=12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "typecheck": "turbo run typecheck",
    "prepare": "husky || true",
    "docker:dev": "docker compose -f compose.yaml -f compose.dev.yaml up -d",
    "docker:dev:down": "docker compose -f compose.yaml -f compose.dev.yaml down",
    "docker:test": "docker compose -f compose.yaml -f compose.test.yaml up --abort-on-container-exit",
    "docker:prod": "docker compose -f compose.yaml -f compose.prod.yaml up -d",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:seed": "npm run db:seed --workspace=apps/backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "msgpackr-extract@3.0.4": true
  }
}
