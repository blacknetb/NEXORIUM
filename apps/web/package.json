{
  "name": "@esm/web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend web de ESM (React + Vite + TypeScript).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo playwright-report test-results"
  },
  "dependencies": {
    "@esm/api-client": "*",
    "@esm/contracts": "*",
    "@esm/validation": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@esm/config-eslint": "*",
    "@esm/config-typescript": "*",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "rimraf": "^5.0.10",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11.1"
  }
}