{
  "name": "@esm/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker de trabajos en segundo plano (colas, cron, jobs) para ESM.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --dts --clean --target node20",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@esm/api-client": "*",
    "@esm/contracts": "*",
    "@esm/validation": "*",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@esm/config-eslint": "*",
    "@esm/config-typescript": "*",
    "@types/node": "^22.10.2",
    "rimraf": "^5.0.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11.1"
  }
}