{
  "name": "@esm/validation",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Esquemas de validación compartidos (Zod) para ESM.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    },
  "files": ["dist"],

  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "zod": "^3.23.8"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@esm/config-typescript": "*",
    "rimraf": "^5.0.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "keywords": [],
  "type": "module"
}
